---
const { title = '慢慢记录', description = '关于生活、阅读、技术与日常的个人记录。' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/my-minimal-blog/">慢慢记录<span>。</span></a>
<nav aria-label="主导航">
  <a href="/my-minimal-blog/">首页</a>
  <a href="/my-minimal-blog/archive/">文章归档</a>
          <a href="/my-minimal-blog/about/">关于</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>写下所想，留住日常。</span>
        <span>用心记录 · 慢慢更新</span>
      </footer>
    </div>
  </body>
</html>
