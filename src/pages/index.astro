---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProducts } from '../lib/products';
import ProductImage from '../components/ProductImage.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const tutorials = (await getCollection('tutorials')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const products = await getProducts();
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const dateFormat = (date: Date) =>
  date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title="首页 — 产品与使用指南"
  description="浏览商品推荐与产品使用教程，或前往联系页面了解客服渠道。"
>
  <section class="hero">
    <p class="eyebrow">产品 · 教程 · 服务</p>
    <h1>产品信息清晰一点，<br /><span>使用体验从容一点。</span></h1>
    <p class="intro">
      这里汇集商品资料、产品使用教程与客服入口。页面中的示例内容仅用于展示网站结构，正式商品与联系信息待补充。
    </p>
    <div class="hero-actions">
      <a class="button-link" href={`${base}products/`}>浏览商品推荐</a>
      <a class="button-link secondary" href={`${base}tutorials/`}>查看使用教程</a>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">商品推荐</p>
        <h2>商品资料一览</h2>
      </div>
      <a class="subtle-link" href={`${base}products/`}>查看全部 ↗</a>
    </div>
    {products.length ? (
      <div class="card-grid">
        {products.slice(0, 3).map((product) => (
          <article class="content-card">
            <div class="product-card-labels">
              <span class="product-category">{product.data.category}</span>
              {product.data.recommended && <span class="sample-badge">推荐</span>}
              {product.data.sample && <span class="sample-badge">示例商品</span>}
            </div>
            <ProductImage image={product.data.image} />
            <h3>{product.data.name}</h3>
            <p>{product.data.summary}</p>
            <div class="product-card-actions">
              <a class="card-link" href={`${base}products/${product.slug}/`}>查看商品资料 ↗</a>
              <a class="product-contact-link" href={`${base}${product.data.contact.page}/`}>{product.data.contact.label}</a>
            </div>
          </article>
        ))}
      </div>
    ) : <p class="empty">商品资料正在整理中。</p>}
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">产品使用教程</p>
        <h2>最新教程</h2>
      </div>
      <a class="subtle-link" href={`${base}tutorials/`}>查看全部 ↗</a>
    </div>
    {tutorials.length ? (
      <div class="card-grid">
        {tutorials.slice(0, 3).map((tutorial) => (
          <article class="content-card">
            {tutorial.data.sample && <span class="sample-badge">示例教程</span>}
            <h3>{tutorial.data.title}</h3>
            <p>{tutorial.data.description}</p>
            <a class="card-link" href={`${base}tutorials/${tutorial.id}/`}>阅读教程 ↗</a>
          </article>
        ))}
      </div>
    ) : <p class="empty">教程正在整理中。</p>}
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">站内文章</p>
        <h2>继续阅读</h2>
      </div>
      <a class="subtle-link" href={`${base}archive/`}>文章归档 ↗</a>
    </div>
    {posts.length ? (
      <div class="post-list">
        {posts.slice(0, 3).map((post) => (
          <article class="post-row">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{dateFormat(post.data.pubDate)}</time>
              <span class="category">{post.data.category}</span>
            </div>
            <div class="post-copy">
              <h3><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <a class="arrow" href={`${base}blog/${post.id}/`} aria-label={`阅读：${post.data.title}`}>↗</a>
          </article>
        ))}
      </div>
    ) : <p class="empty">暂时没有文章。</p>}
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">联系客服</p>
        <h2>需要进一步了解？</h2>
      </div>
      <a class="button-link" href={`${base}contact/`}>联系说明 ↗</a>
    </div>
    <p class="intro">前往联系页面查看当前客服渠道配置状态。网站尚未提供可用的企业微信客服链接或二维码。</p>
  </section>
</BaseLayout>
