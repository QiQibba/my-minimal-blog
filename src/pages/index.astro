---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const categories = [...new Set(posts.map((post) => post.data.category))];
const dateFormat = (date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="慢慢记录 — 个人博客" description="关于生活、阅读、技术与日常的个人记录。">
  <section class="hero">
    <p class="eyebrow">A PERSONAL JOURNAL</p>
    <h1>把日子过成文字，<br /><span>把想法慢慢写下来。</span></h1>
    <p class="intro">这里记录生活里的小事、读过的书、用过的工具，以及那些值得多想一会儿的念头。</p>
    <a class="text-link" href="/about">认识一下这个博客 <span aria-hidden="true">↗</span></a>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">THE JOURNAL</p><h2>最近写下的</h2></div>
      <a class="subtle-link" href="/archive">全部文章 ↗</a>
    </div>
    {posts.length ? (
      <div class="post-list">
        {posts.map((post) => (
          <article class="post-row">
            <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{dateFormat(post.data.pubDate)}</time><span class="category">{post.data.category}</span></div>
            <div class="post-copy">
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div>}
            </div>
            <a class="arrow" href={`/blog/${post.id}/`} aria-label={`阅读：${post.data.title}`}>↗</a>
          </article>
        ))}
      </div>
    ) : <p class="empty">还没有文章。添加第一篇 Markdown 文章后，它就会出现在这里。</p>}
  </section>

  <section class="topic-strip">
    <div><p class="eyebrow">CATEGORIES</p><h2>写作的几个方向</h2></div>
    <div class="topic-list">
      {['生活记录', '阅读思考', '技术与工具', '随手写写'].map((topic, i) => <span><b>0{i + 1}</b> {topic}</span>)}
    </div>
  </section>
</BaseLayout>
