---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const tutorials = await getCollection('tutorials');
const tutorialRecords = tutorials.map((tutorial) => ({
  slug: tutorial.id,
  title: tutorial.data.title,
  description: tutorial.data.description,
  pubDate: tutorial.data.pubDate.toISOString().slice(0, 10),
  tags: tutorial.data.tags.join(', '),
  detail: tutorial.body,
}));
---
<BaseLayout title="内容管理后台" description="商品、教程、视频教程和文档说明的内容编辑框架。">
  <section class="admin-page">
    <p class="eyebrow">内容管理</p>
    <h1>网站内容后台</h1>
    <p class="admin-lead">选择内容类型后填写表单。商品和现有文字教程可载入公开资料。</p>

    <aside class="admin-warning" role="status">
      <strong>管理页面受 Cloudflare Access 保护</strong>
      <p>公开商品列表只读；下方商品草稿单独保存在 D1，不会修改正式商品。发布功能尚未接入，请勿将未确认内容视为已发布。</p>
    </aside>

    <div
      class="admin-record-data"
      data-tutorials={JSON.stringify(tutorialRecords)}
    ></div>

    <section class="admin-product-section" aria-labelledby="admin-products-title">
      <h2 id="admin-products-title">商品列表</h2>
      <p class="admin-product-status" id="product-list-status" role="status" aria-live="polite">正在读取商品列表…</p>
      <ul class="admin-product-list" id="product-list"></ul>
    </section>

    <section class="admin-draft-section" aria-labelledby="admin-drafts-title">
      <div class="admin-draft-heading">
        <div>
          <h2 id="admin-drafts-title">商品草稿（D1）</h2>
          <p class="admin-hint">这里只显示草稿 API 中的商品草稿；不会与上方公开商品列表混用。</p>
        </div>
        <button class="button-link secondary admin-draft-action" type="button" id="new-draft-button">新建商品草稿</button>
      </div>
      <p class="admin-product-status" id="draft-list-status" role="status" aria-live="polite">正在读取商品草稿…</p>
      <ul class="admin-product-list" id="draft-list"></ul>
    </section>

    <form class="admin-form" id="admin-form">
      <div class="admin-form-heading">
        <h2>编辑内容</h2>
        <label class="admin-control">
          内容类型
          <select id="content-type" name="contentType">
            <option value="product">商品</option>
            <option value="tutorial">产品使用教程</option>
            <option value="video">视频教程</option>
            <option value="document">文档说明</option>
          </select>
        </label>
      </div>

      <div class="admin-mode-row">
        <label class="admin-control">
          编辑方式
          <select id="edit-mode" name="editMode">
            <option value="new">新增内容</option>
            <option value="edit">编辑现有内容</option>
          </select>
        </label>
        <label class="admin-control" id="existing-entry-control" hidden>
          选择现有内容
          <select id="existing-entry" name="existingEntry"></select>
        </label>
      </div>

      <p class="admin-empty-note" id="no-existing-note" hidden>此类型目前没有可编辑的已发布内容。</p>

      <div class="admin-fields" data-content-fields="product">
        <label class="admin-control">
          唯一标识（文件名 slug）
          <input name="slug" type="text" placeholder="例如 travel-mug" autocomplete="off" />
        </label>
        <label class="admin-control">
          商品名称
          <input name="name" type="text" />
        </label>
        <label class="admin-control">
          商品分类
          <input name="category" type="text" />
        </label>
        <label class="admin-control">
          商品简介
          <textarea name="summary" rows="3"></textarea>
        </label>
        <fieldset class="admin-media-fields">
          <legend>商品图片（可选）</legend>
          <label class="admin-control">
            图片路径或 HTTPS 地址
            <input name="imageSrc" type="url" placeholder="/images/products/example.webp" />
          </label>
          <label class="admin-control">
            图片替代文字
            <input name="imageAlt" type="text" />
          </label>
          <p>仓库图片应放在 <code>public/images/products/</code>，字段路径从 <code>/images/products/</code> 开始填写。</p>
        </fieldset>
        <label class="admin-control">
          规格（每行一项，格式：名称: 内容）
          <textarea name="specs" rows="4" placeholder="材质: 已确认的材质"></textarea>
        </label>
        <label class="admin-control">
          特点（每行一项）
          <textarea name="features" rows="4"></textarea>
        </label>
        <label class="admin-checkbox"><input name="recommended" type="checkbox" /> 推荐展示</label>
        <label class="admin-control">
          联系入口文字
          <input name="contactLabel" type="text" value="咨询客服" />
        </label>
        <label class="admin-control">
          商品详细介绍（Markdown）
          <textarea name="detail" rows="8"></textarea>
        </label>
      </div>

      <div class="admin-fields" data-content-fields="tutorial" hidden>
        <label class="admin-control">
          唯一标识（文件名 slug）
          <input name="slug" type="text" placeholder="例如 setup-guide" autocomplete="off" />
        </label>
        <label class="admin-control">
          教程标题
          <input name="title" type="text" />
        </label>
        <label class="admin-control">
          教程简介
          <textarea name="description" rows="3"></textarea>
        </label>
        <label class="admin-control">
          发布日期
          <input name="pubDate" type="date" />
        </label>
        <label class="admin-control">
          标签（逗号分隔）
          <input name="tags" type="text" />
        </label>
        <label class="admin-control">
          教程内容（Markdown，可加入图片链接）
          <textarea name="detail" rows="10"></textarea>
        </label>
      </div>

      <div class="admin-fields" data-content-fields="video" hidden>
        <label class="admin-control">
          唯一标识（文件名 slug）
          <input name="slug" type="text" placeholder="例如 product-video-guide" autocomplete="off" />
        </label>
        <label class="admin-control">
          视频教程标题
          <input name="title" type="text" />
        </label>
        <label class="admin-control">
          简介
          <textarea name="description" rows="3"></textarea>
        </label>
        <label class="admin-control">
          视频地址（视频平台或对象存储/CDN）
          <input name="videoUrl" type="url" />
        </label>
        <label class="admin-control">
          封面图片地址（可选）
          <input name="thumbnailUrl" type="url" />
        </label>
        <label class="admin-control">
          文字说明（可选，Markdown）
          <textarea name="detail" rows="8"></textarea>
        </label>
      </div>

      <div class="admin-fields" data-content-fields="document" hidden>
        <label class="admin-control">
          唯一标识（文件名 slug）
          <input name="slug" type="text" placeholder="例如 product-manual" autocomplete="off" />
        </label>
        <label class="admin-control">
          文档标题
          <input name="title" type="text" />
        </label>
        <label class="admin-control">
          文档简介
          <textarea name="description" rows="3"></textarea>
        </label>
        <label class="admin-control">
          文档文件地址（PDF 等）
          <input name="fileUrl" type="url" placeholder="/documents/manual.pdf" />
        </label>
        <label class="admin-control">
          正文说明（Markdown，可选）
          <textarea name="detail" rows="8"></textarea>
        </label>
        <p class="admin-hint">小型公开文件可存放于 <code>public/documents/</code>；较大文件建议使用对象存储/CDN。此表单尚未上传文件。</p>
      </div>

      <div class="admin-actions">
        <button class="button-link secondary" type="button" id="preview-button">预览填写内容</button>
        <button class="button-link admin-draft-action" type="button" id="save-button" disabled>保存草稿</button>
        <button class="button-link" type="button" id="publish-button" disabled>发布内容</button>
      </div>
      <p class="admin-hint">发布功能尚未接入，发布按钮保持禁用；保存操作只会创建或更新 D1 草稿。</p>
      <p class="admin-feedback" id="admin-feedback" role="status" aria-live="polite"></p>
    </form>

    <section class="admin-preview" id="admin-preview" hidden aria-label="内容预览">
      <p class="eyebrow">本地预览</p>
      <h2 id="preview-title"></h2>
      <p id="preview-summary"></p>
      <pre id="preview-body"></pre>
      <p class="admin-hint" id="preview-note">预览只根据当前表单内容生成，不保存或发布。</p>
    </section>
  </section>
</BaseLayout>

<style>
  .admin-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 0 72px;
  }

  .admin-page h1,
  .admin-form h2,
  .admin-preview h2 {
    font-family: "Noto Serif SC", serif;
  }

  .admin-page h1 {
    margin-bottom: 10px;
    font-size: clamp(30px, 6vw, 42px);
  }

  .admin-lead,
  .admin-warning p,
  .admin-media-fields p,
  .admin-hint,
  .admin-empty-note {
    color: var(--muted);
    font-size: 14px;
  }

  .admin-warning {
    margin: 24px 0;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent-strong);
    border-radius: 8px;
    background: var(--card);
  }

  .admin-warning strong {
    display: block;
    margin-bottom: 6px;
  }

  .admin-warning p,
  .admin-media-fields p {
    margin: 0;
  }

  .admin-product-section {
    margin-top: 28px;
  }

  .admin-draft-section {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .admin-draft-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .admin-draft-heading h2 {
    margin: 0 0 8px;
    font-family: "Noto Serif SC", serif;
    font-size: 23px;
  }

  .admin-draft-heading .admin-hint {
    margin: 0 0 12px;
  }

  .admin-product-section h2 {
    margin-bottom: 12px;
    font-family: "Noto Serif SC", serif;
    font-size: 23px;
  }

  .admin-product-status {
    color: var(--muted);
    font-size: 14px;
  }

  .admin-product-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .admin-product-item {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
  }

  .admin-product-item h3 {
    margin: 0 0 4px;
    font-size: 17px;
  }

  .admin-product-item p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .admin-draft-item-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .admin-draft-item-actions .button-link {
    min-height: 38px;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
  }

  .admin-form,
  .admin-preview {
    display: grid;
    gap: 20px;
    margin-top: 28px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }

  .admin-form-heading,
  .admin-mode-row,
  .admin-actions {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 14px;
  }

  .admin-form-heading {
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .admin-form-heading h2 {
    margin: 0;
    font-size: 23px;
  }

  .admin-control {
    display: grid;
    flex: 1 1 260px;
    gap: 7px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }

  .admin-control input,
  .admin-control textarea,
  .admin-control select {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 400;
  }

  .admin-control textarea {
    min-height: 92px;
    resize: vertical;
  }

  .admin-fields {
    display: grid;
    gap: 16px;
  }

  .admin-fields[hidden],
  .admin-preview[hidden],
  .admin-mode-row [hidden] {
    display: none;
  }

  .admin-media-fields {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .admin-media-fields legend {
    padding: 0 6px;
    font-weight: 600;
  }

  .admin-checkbox {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 9px;
    font-size: 14px;
  }

  .admin-checkbox input {
    width: 18px;
    height: 18px;
    accent-color: var(--accent-strong);
  }

  .admin-actions {
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .admin-actions .button-link {
    min-height: 44px;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
  }

  .admin-actions .button-link:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .admin-draft-item-actions .button-link:disabled,
  .admin-draft-heading .button-link:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .admin-feedback {
    min-height: 1.5em;
    margin: 0;
    color: var(--accent-strong);
    font-size: 14px;
  }

  .admin-preview h2 {
    margin: 0;
  }

  .admin-preview p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .admin-preview pre {
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    font: inherit;
  }

  @media (max-width: 620px) {
    .admin-page {
      padding: 36px 0 56px;
    }

    .admin-form,
    .admin-preview {
      padding: 18px;
    }

    .admin-form-heading {
      align-items: stretch;
      flex-direction: column;
    }

    .admin-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .admin-actions .button-link {
      width: 100%;
      justify-content: center;
    }

    .admin-draft-heading {
      align-items: stretch;
      flex-direction: column;
    }

    .admin-draft-heading > .button-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  import {
    createProductDraft,
    deleteProductDraft,
    DraftApiError,
    getContentApiProducts,
    getProductDraft,
    getProductDraftPreview,
    getProductDrafts,
    updateProductDraft,
    type ContentApiRecord,
    type ContentDraft,
    type ProductDraftContent,
  } from '../../lib/content-api';

  type ExistingRecord = ContentApiRecord;

  const recordData = document.querySelector<HTMLElement>('.admin-record-data');
  const records: Record<string, ExistingRecord[]> = {
    product: [],
    tutorial: JSON.parse(recordData?.dataset.tutorials ?? '[]'),
    video: [],
    document: [],
  };
  const contentType = document.querySelector<HTMLSelectElement>('#content-type');
  const editMode = document.querySelector<HTMLSelectElement>('#edit-mode');
  const existingEntryControl = document.querySelector<HTMLElement>('#existing-entry-control');
  const existingEntry = document.querySelector<HTMLSelectElement>('#existing-entry');
  const noExistingNote = document.querySelector<HTMLElement>('#no-existing-note');
  const form = document.querySelector<HTMLFormElement>('#admin-form');
  const feedback = document.querySelector<HTMLElement>('#admin-feedback');
  const preview = document.querySelector<HTMLElement>('#admin-preview');
  const previewNote = document.querySelector<HTMLElement>('#preview-note');
  const productList = document.querySelector<HTMLUListElement>('#product-list');
  const productListStatus = document.querySelector<HTMLElement>('#product-list-status');
  const draftList = document.querySelector<HTMLUListElement>('#draft-list');
  const draftListStatus = document.querySelector<HTMLElement>('#draft-list-status');
  const saveButton = document.querySelector<HTMLButtonElement>('#save-button');
  const newDraftButton = document.querySelector<HTMLButtonElement>('#new-draft-button');
  let currentDraftId: string | null = null;
  let draftBusy = false;

  function activeFields() {
    return document.querySelector<HTMLElement>(`[data-content-fields="${contentType?.value}"]`);
  }

  function setDraftBusy(busy: boolean) {
    draftBusy = busy;
    document.querySelectorAll<HTMLButtonElement>('.admin-draft-action').forEach((button) => {
      button.disabled = busy;
    });
    updateDraftButtonState();
  }

  function updateDraftButtonState() {
    if (saveButton) {
      saveButton.disabled = draftBusy || contentType?.value !== 'product';
    }
  }

  function draftErrorMessage(error: unknown) {
    if (error instanceof DraftApiError && error.status === 401) {
      return '未登录或登录已过期。请通过 Cloudflare Access 重新登录后重试。';
    }
    if (error instanceof DraftApiError && error.status === 403) {
      return '当前账号没有管理商品草稿的权限。';
    }
    return error instanceof Error ? error.message : '发生未知错误，请重试。';
  }

  function showDraftError(error: unknown) {
    if (feedback) feedback.textContent = `草稿操作失败：${draftErrorMessage(error)}`;
  }

  function setFormValue(name: string, value: string | boolean) {
    const field = activeFields()?.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
    if (!field) return;
    if (field instanceof HTMLInputElement && field.type === 'checkbox') {
      field.checked = Boolean(value);
    } else {
      field.value = String(value);
    }
  }

  function updateRecordOptions(resetNewFields = true, populateSelected = true) {
    if (!contentType || !existingEntry || !editMode || !existingEntryControl || !noExistingNote) return;

    const type = contentType.value;
    const typeRecords = records[type] ?? [];
    existingEntry.replaceChildren();

    for (const record of typeRecords) {
      const option = document.createElement('option');
      option.value = String(record.slug ?? '');
      option.textContent = String(record.name ?? record.title ?? record.slug ?? '未命名内容');
      option.dataset.record = JSON.stringify(record);
      existingEntry.append(option);
    }

    const editing = editMode.value === 'edit';
    existingEntryControl.hidden = !editing || typeRecords.length === 0;
    noExistingNote.hidden = !editing || typeRecords.length > 0;

    if (editing && populateSelected && existingEntry.selectedOptions[0]) {
      populateRecord(JSON.parse(existingEntry.selectedOptions[0].dataset.record ?? '{}'));
    } else if (!editing && resetNewFields) {
      activeFields()?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((field) => {
        if (field instanceof HTMLInputElement && field.type === 'checkbox') {
          field.checked = false;
        } else {
          field.value = '';
        }
      });
      setFormValue('contactLabel', '咨询客服');
    }
  }

  function populateRecord(record: ExistingRecord) {
    for (const [name, value] of Object.entries(record)) {
      setFormValue(name, value);
    }
  }

  function isObjectRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null && !Array.isArray(value);
  }

  function draftString(data: Record<string, unknown>, key: string) {
    return typeof data[key] === 'string' ? data[key] : '';
  }

  function draftSpecs(data: Record<string, unknown>) {
    if (!Array.isArray(data.specs)) return [];
    return data.specs.flatMap((spec) => {
      if (
        !isObjectRecord(spec) ||
        typeof spec.label !== 'string' ||
        typeof spec.value !== 'string'
      ) {
        return [];
      }
      return [{ label: spec.label, value: spec.value }];
    });
  }

  function draftFeatures(data: Record<string, unknown>) {
    return Array.isArray(data.features)
      ? data.features.filter((feature): feature is string => typeof feature === 'string')
      : [];
  }

  function populateDraft(draft: ContentDraft) {
    const data = draft.content_json;
    const image = isObjectRecord(data.image) ? data.image : {};
    const contact = isObjectRecord(data.contact) ? data.contact : {};
    setFormValue('slug', draft.slug);
    setFormValue('name', draftString(data, 'name') || draft.title);
    setFormValue('category', draftString(data, 'category'));
    setFormValue('summary', draftString(data, 'summary'));
    setFormValue('imageSrc', typeof image.src === 'string' ? image.src : '');
    setFormValue('imageAlt', typeof image.alt === 'string' ? image.alt : '');
    setFormValue('specs', draftSpecs(data).map(({ label, value }) => `${label}: ${value}`).join('\n'));
    setFormValue('features', draftFeatures(data).join('\n'));
    setFormValue('recommended', data.recommended === true);
    setFormValue('contactLabel', typeof contact.label === 'string' ? contact.label : '咨询客服');
    setFormValue('detail', draftString(data, 'detail'));
    currentDraftId = draft.id;
    if (editMode) editMode.value = 'new';
    updateRecordOptions(false, false);
    if (feedback) feedback.textContent = `已载入草稿「${draft.title}」，保存时将更新此 D1 草稿。`;
  }

  function readValue(name: string) {
    const field = activeFields()?.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
    if (!field) return '';
    return field instanceof HTMLInputElement && field.type === 'checkbox'
      ? String(field.checked)
      : field.value.trim();
  }

  function serializeProductDraft() {
    const title = readValue('name');
    const slug = readValue('slug');
    const category = readValue('category');
    const summary = readValue('summary');
    const imageSrc = readValue('imageSrc');
    const imageAlt = readValue('imageAlt');

    if (!title || title.length > 200) {
      throw new Error('商品名称必填且不能超过 200 个字符。');
    }
    if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug) || slug.length > 100) {
      throw new Error('slug 必须是最多 100 个字符的小写字母、数字和连字符。');
    }
    if (!category || !summary) {
      throw new Error('请填写商品分类和商品简介。');
    }
    if (Boolean(imageSrc) !== Boolean(imageAlt)) {
      throw new Error('填写商品图片时，图片地址和替代文字都必须填写。');
    }
    if (imageSrc && !(/^\/images\/products\/[^?#\s]+$/.test(imageSrc) || /^https:\/\/\S+$/i.test(imageSrc))) {
      throw new Error('商品图片地址须位于 /images/products/ 或使用 HTTPS。');
    }

    const specs = readValue('specs')
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => {
        const separator = line.indexOf(':');
        if (separator < 1 || !line.slice(separator + 1).trim()) {
          throw new Error('规格请按“名称: 内容”逐行填写。');
        }
        return {
          label: line.slice(0, separator).trim(),
          value: line.slice(separator + 1).trim(),
        };
      });
    const features = readValue('features')
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean);
    const contentJson: ProductDraftContent = {
      name: title,
      category,
      summary,
      ...(imageSrc ? { image: { src: imageSrc, alt: imageAlt } } : {}),
      specs,
      features,
      recommended: readValue('recommended') === 'true',
      contact: {
        label: readValue('contactLabel') || '咨询客服',
        page: 'contact',
      },
      sample: false,
      detail: readValue('detail'),
    };

    if (new TextEncoder().encode(JSON.stringify(contentJson)).byteLength > 48 * 1024) {
      throw new Error('草稿内容超过 48 KiB，请缩短商品介绍或字段内容。');
    }

    return {
      content_type: 'product' as const,
      title,
      slug,
      content_json: contentJson,
    };
  }

  function renderDraftPreview(draft: ContentDraft) {
    if (!preview) return;
    const data = draft.content_json;
    const image = isObjectRecord(data.image) ? data.image : {};
    const contact = isObjectRecord(data.contact) ? data.contact : {};
    const specs = draftSpecs(data);
    const features = draftFeatures(data);
    const summary = [draftString(data, 'category'), draftString(data, 'summary')]
      .filter(Boolean)
      .join(' · ');
    const details = [
      typeof image.src === 'string' && image.src
        ? `图片：${image.src}\n替代文字：${typeof image.alt === 'string' ? image.alt : ''}`
        : '',
      specs.length
        ? `规格：\n${specs.map(({ label, value }) => `${label}: ${value}`).join('\n')}`
        : '',
      features.length ? `特点：\n${features.join('\n')}` : '',
      `推荐展示：${data.recommended === true ? '是' : '否'}`,
      `咨询入口：${typeof contact.label === 'string' ? contact.label : '咨询客服'}`,
      draftString(data, 'detail') ? `详细介绍：\n${draftString(data, 'detail')}` : '',
    ].filter(Boolean);

    preview.querySelector<HTMLElement>('#preview-title')!.textContent = draft.title;
    preview.querySelector<HTMLElement>('#preview-summary')!.textContent = summary;
    preview.querySelector<HTMLElement>('#preview-body')!.textContent = details.join('\n\n');
    if (previewNote) previewNote.textContent = '此内容来自 D1 草稿预览接口；仅供预览，不会发布。';
    preview.hidden = false;
    preview.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderDraftList(drafts: ContentDraft[]) {
    if (!draftList) return;
    draftList.replaceChildren();

    for (const draft of drafts) {
      const item = document.createElement('li');
      item.className = 'admin-product-item';

      const title = document.createElement('h3');
      title.textContent = draft.title;
      item.append(title);

      const metadata = document.createElement('p');
      metadata.textContent = `Slug：${draft.slug} · 状态：${draft.status} · 更新：${draft.updated_at}`;
      item.append(metadata);

      const actions = document.createElement('div');
      actions.className = 'admin-draft-item-actions';
      const edit = document.createElement('button');
      edit.className = 'button-link secondary admin-draft-action';
      edit.type = 'button';
      edit.textContent = '编辑';
      edit.addEventListener('click', () => {
        void runDraftAction(async () => {
          if (contentType) contentType.value = 'product';
          document.querySelectorAll<HTMLElement>('[data-content-fields]').forEach((fields) => {
            fields.hidden = fields.dataset.contentFields !== 'product';
          });
          currentDraftId = null;
          const latestDraft = await getProductDraft(draft.id);
          populateDraft(latestDraft);
          if (preview) preview.hidden = true;
          feedback?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });

      const previewButton = document.createElement('button');
      previewButton.className = 'button-link secondary admin-draft-action';
      previewButton.type = 'button';
      previewButton.textContent = '预览';
      previewButton.addEventListener('click', () => {
        void runDraftAction(async () => {
          const previewDraft = await getProductDraftPreview(draft.id);
          renderDraftPreview(previewDraft);
          if (feedback) feedback.textContent = `已读取草稿「${previewDraft.title}」的 D1 预览。`;
        });
      });

      const remove = document.createElement('button');
      remove.className = 'button-link secondary admin-draft-action';
      remove.type = 'button';
      remove.textContent = '删除';
      remove.addEventListener('click', () => {
        if (!window.confirm(`确定删除草稿「${draft.title}」吗？此操作不可撤销。`)) {
          if (feedback) feedback.textContent = `已取消删除草稿「${draft.title}」。`;
          return;
        }
        void runDraftAction(async () => {
          await deleteProductDraft(draft.id);
          if (currentDraftId === draft.id) resetProductDraftEditor();
          if (feedback) feedback.textContent = `草稿「${draft.title}」已删除。`;
          await loadDrafts();
        });
      });

      actions.append(edit, previewButton, remove);
      item.append(actions);
      draftList.append(item);
    }
  }

  async function loadDrafts() {
    if (!draftListStatus) return;
    draftListStatus.textContent = '正在读取商品草稿…';
    try {
      const drafts = await getProductDrafts();
      renderDraftList(drafts);
      draftListStatus.textContent = drafts.length
        ? `已读取 ${drafts.length} 个商品草稿。`
        : '目前没有商品草稿。';
    } catch (error) {
      draftList?.replaceChildren();
      draftListStatus.textContent = `草稿列表读取失败：${draftErrorMessage(error)}`;
    }
  }

  async function runDraftAction(action: () => Promise<void>) {
    if (draftBusy) return;
    setDraftBusy(true);
    try {
      await action();
    } catch (error) {
      showDraftError(error);
    } finally {
      setDraftBusy(false);
    }
  }

  function resetProductDraftEditor() {
    if (contentType) contentType.value = 'product';
    if (editMode) editMode.value = 'new';
    document.querySelectorAll<HTMLElement>('[data-content-fields]').forEach((fields) => {
      fields.hidden = fields.dataset.contentFields !== 'product';
    });
    currentDraftId = null;
    activeFields()?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((field) => {
      if (field instanceof HTMLInputElement && field.type === 'checkbox') {
        field.checked = false;
      } else {
        field.value = '';
      }
    });
    setFormValue('contactLabel', '咨询客服');
    if (preview) preview.hidden = true;
    if (feedback) feedback.textContent = '已新建空白商品草稿表单；点击保存后将写入 D1。';
    updateRecordOptions(false, false);
    updateDraftButtonState();
  }

  async function loadProducts() {
    try {
      records.product = await getContentApiProducts();
      if (productList && productListStatus) {
        productList.replaceChildren();
        for (const product of records.product) {
          const item = document.createElement('li');
          item.className = 'admin-product-item';

          const name = document.createElement('h3');
          name.textContent = product.name;
          item.append(name);

          const category = document.createElement('p');
          category.textContent = `分类：${product.category}`;
          item.append(category);

          const summary = document.createElement('p');
          summary.textContent = product.summary;
          item.append(summary);

          productList.append(item);
        }
        productListStatus.textContent = `已读取 ${records.product.length} 个商品。`;
      }
      updateRecordOptions(false, false);
    } catch (error) {
      if (productListStatus) {
        const reason = error instanceof Error ? error.message : '未知错误';
        productListStatus.textContent = `商品列表读取失败：${reason}`;
      }
    }
  }

  contentType?.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>('[data-content-fields]').forEach((fields) => {
      fields.hidden = fields.dataset.contentFields !== contentType.value;
    });
    currentDraftId = null;
    updateRecordOptions();
    updateDraftButtonState();
    if (feedback) feedback.textContent = '';
    if (preview) preview.hidden = true;
    if (previewNote) previewNote.textContent = '预览只根据当前表单内容生成，不保存或发布。';
  });

  editMode?.addEventListener('change', () => {
    currentDraftId = null;
    updateRecordOptions();
  });
  existingEntry?.addEventListener('change', () => {
    const record = existingEntry.selectedOptions[0]?.dataset.record;
    if (record) {
      currentDraftId = null;
      populateRecord(JSON.parse(record));
    }
  });

  newDraftButton?.addEventListener('click', resetProductDraftEditor);

  saveButton?.addEventListener('click', () => {
    void runDraftAction(async () => {
      const input = serializeProductDraft();
      const draftId = currentDraftId;
      const wasEditingDraft = draftId !== null;
      const saved = draftId !== null
        ? await updateProductDraft(draftId, input)
        : await createProductDraft(input);
      currentDraftId = saved.id;
      if (feedback) {
        feedback.textContent = wasEditingDraft
          ? `商品草稿「${saved.title}」已更新并保存到 D1。`
          : `商品草稿「${saved.title}」已创建并保存到 D1。`;
      }
      await loadDrafts();
    });
  });

  document.querySelector<HTMLButtonElement>('#publish-button')?.addEventListener('click', () => {
    if (feedback) feedback.textContent = '发布功能尚未接入；草稿仍只保存在 D1，未修改正式商品。';
  });

  document.querySelector<HTMLButtonElement>('#preview-button')?.addEventListener('click', () => {
    if (!preview) return;
    const title = readValue('name') || readValue('title') || readValue('slug') || '未命名内容';
    const summary = readValue('summary') || readValue('description') || readValue('videoUrl') || readValue('fileUrl');
    const body = readValue('detail');
    preview.querySelector<HTMLElement>('#preview-title')!.textContent = title;
    preview.querySelector<HTMLElement>('#preview-summary')!.textContent = summary;
    preview.querySelector<HTMLElement>('#preview-body')!.textContent = body;
    if (previewNote) previewNote.textContent = '预览只根据当前表单内容生成，不保存或发布。';
    preview.hidden = false;
    preview.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (feedback) feedback.textContent = '已生成当前表单的临时预览；内容未保存。';
  });

  form?.addEventListener('submit', (event) => event.preventDefault());
  updateRecordOptions();
  updateDraftButtonState();
  void loadProducts();
  void loadDrafts();
</script>
